{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "tracking-script/dist",
  "nodeVersion": "20.18.0",
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
